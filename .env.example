# Copy to .env and fill in the values from your GitHub OAuth App
# (https://github.com/settings/applications/new).
#
#   Application name:            Harness Lab Login
#   Homepage URL:                http://localhost:5173
#   Authorization callback URL:  http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Backend port and the origin the app is opened from.
PORT=3000
APP_ORIGIN=http://localhost:5173

# Optional override. Defaults to <APP_ORIGIN>/api/auth/github/callback and must
# match the callback URL registered on the GitHub OAuth App.
# GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# Set to true when serving over https so the session cookie is Secure.
COOKIE_SECURE=false
