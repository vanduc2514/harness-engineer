# Copy to .env and fill in the values from your GitHub OAuth App
# (https://github.com/settings/applications/new).
#
#   Application name:            Harness Lab Login
#   Homepage URL:                http://localhost:5173
#   Authorization callback URL:  http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Backend port and the origin the app is opened from. On a deployment, APP_ORIGIN is
# the public origin, for example https://harness-engineer.vercel.app
PORT=3000
APP_ORIGIN=http://localhost:5173

# Optional override. Defaults to <APP_ORIGIN>/api/auth/github/callback and must
# match the callback URL registered on the GitHub OAuth App.
# GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# Set to true when serving over https so the session cookie is Secure, and so the
# cookie survives the deployment hop. Required on Vercel.
COOKIE_SECURE=false

# Port the Vite dev server listens on. Must be part of APP_ORIGIN when changed.
WEB_PORT=5173

# Override the GitHub endpoints. Only for the browser test in e2e/, which points
# them at a local stub so the full sign-in flow can run without touching GitHub.
# GITHUB_AUTHORIZE_URL=http://localhost:3299/login/oauth/authorize
# GITHUB_TOKEN_URL=http://localhost:3299/login/oauth/access_token
# GITHUB_USER_URL=http://localhost:3299/user
